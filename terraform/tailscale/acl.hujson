{
	// Map device names to Tailscale IPs for readability.
	"hosts": {
		"mba": "100.89.154.98",
		"nixos": "100.67.38.61",
	},

	"grants": [
		// Allow only mba -> nixos. nixos -> mba is blocked.
		{"src": ["host:mba"], "dst": ["host:nixos"], "ip": ["*"]},
	],

	// Test access rules every time they're saved.
	"tests": [
		{
			"src": "mba",
			"accept": ["nixos:22"],
		},
		{
			"src": "nixos",
			"deny": ["mba:22"],
		},
	],
}
